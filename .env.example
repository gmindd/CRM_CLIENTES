# ---------------------------------------------------------------------------
# CRM · Clientes — copie para .env e preencha
# ---------------------------------------------------------------------------

# Endereço público (usado nos links dos emails de alerta)
APP_URL=https://crm.pereiragabriel.com

# Fuso horário usado nas datas e no agendador
TZ=Europe/Lisbon

# --- Acesso -----------------------------------------------------------------
# Gere estes valores com:  npm run hash-password -- "a-sua-password"
APP_PASSWORD_HASH=
# Alternativa ao anterior, para painéis web (Coolify, Portainer): o mesmo hash
# em base64, sem o '$' que alguns painéis interpretam como variável.
# APP_PASSWORD_HASH_B64=
# Segredo que assina o cookie de sessão (mínimo 32 caracteres)
# openssl rand -base64 48
SESSION_SECRET=
# Dias que a sessão se mantém iniciada
SESSION_DAYS=7

# --- Base de dados ----------------------------------------------------------
# Ficheiro SQLite. Em Docker é /app/data/crm.sqlite (volume persistente).
DATABASE_PATH=./data/crm.sqlite

# --- Email (alertas de pagamento) -------------------------------------------
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
# true para porta 465 (TLS implícito); em branco deduz pela porta
SMTP_SECURE=
SMTP_USER=crm@pereiragabriel.com
SMTP_PASS=
# Remetente dos emails
MAIL_FROM="CRM <crm@pereiragabriel.com>"
# Para onde vão os alertas (o seu email pessoal)
ALERT_EMAIL_TO=pereiragabriel.gp@gmail.com

# --- Agendador de alertas ---------------------------------------------------
# Verificação automática dentro da própria aplicação (sem cron externo)
ALERTAS_AUTO=true
# Todos os dias às 09:00
ALERTAS_CRON=0 9 * * *
# Segredo para acionar /api/cron/alertas a partir do exterior (opcional)
# openssl rand -hex 24
CRON_SECRET=

# --- Proteção do login ------------------------------------------------------
LOGIN_MAX_TENTATIVAS=8
LOGIN_JANELA_MINUTOS=15
